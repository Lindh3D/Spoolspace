# Optional configuration. Copy this file to .env and restart Spoolspace.
# HOST=0.0.0.0 allows phones on the same trusted LAN to reach the server.
# Use HOST=127.0.0.1 to restrict access to this PC.
HOST=0.0.0.0
PORT=4173

# Local SQLite database and runtime files. Relative to the project folder.
DATA_DIR=./data

# Optional installed Ollama vision model; leave blank to use local OCR only.
# You can also choose the model in the app's Settings page.
# Ollama is contacted only at http://127.0.0.1:11434/api/generate.
OLLAMA_MODEL=

# HTTP is the default for home Wi-Fi. No certificates are created or required.
# Optional HTTPS: explicitly change HTTPS_MODE to auto and trust its local CA.
HTTPS_MODE=off
HTTPS_PORT=4174
# Optional: use your own certificate instead. Both PEM files are required.
# TLS_CERT_FILE=C:/SpoolspaceCertificates/server.crt
# TLS_KEY_FILE=C:/SpoolspaceCertificates/server.key
# Explicit DNS names used by your certificate or reverse proxy.
# ALLOWED_HOSTS=spool.home.arpa
# Set false for an empty inventory on first startup (installed bundles do this).
# SEED_DEMO=false
